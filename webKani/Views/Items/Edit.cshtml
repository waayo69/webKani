@model webKani.Models.Item
@{
    ViewData["Title"] = "Edit";
}
<h2>Edit Book</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Title</label>
        <input asp-for="Title" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Author</label>
        <input asp-for="Author" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Genre</label>
        <select asp-for="Genre" class="form-control">
            @foreach (var genre in ViewBag.Genres)
            {
                <option value="@genre" selected="@(genre == Model.Genre ? "selected" : null)">@genre</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>Price</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" required />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>